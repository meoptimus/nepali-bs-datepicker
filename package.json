{
  "name": "nepali-bs-datepicker",
  "version": "2.0.0",
  "description": "Bikram Sambat (Nepali) datepicker for jQuery, API- and CSS-compatible with bootstrap-datepicker",
  "homepage": "https://github.com/sumanbymail/nepali-bs-datepicker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanbymail/nepali-bs-datepicker.git"
  },
  "bugs": {
    "url": "https://github.com/sumanbymail/nepali-bs-datepicker/issues"
  },
  "main": "dist/js/nepali-datepicker.js",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check-calendar": "node scripts/check-calendar.js",
    "test": "node scripts/check-calendar.js && node --test \"test/*.test.js\"",
    "test:tz": "node test/tz-runner.js America/Los_Angeles && node test/tz-runner.js Asia/Kathmandu",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "nepali",
    "bikram-sambat",
    "bs",
    "datepicker",
    "calendar",
    "jquery-plugin",
    "bootstrap"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "jquery": ">=1.12 <5"
  },
  "devDependencies": {
    "jquery": "^3.7.1",
    "jsdom": "^26.1.0",
    "terser": "^5.39.0"
  },
  "unpkg": "dist/js/nepali-datepicker.min.js",
  "jsdelivr": "dist/js/nepali-datepicker.min.js",
  "style": "dist/css/bootstrap-datepicker3.standalone.css",
  "sideEffects": [
    "*.css",
    "dist/js/*.js"
  ],
  "author": "Suman Paudyal"
}
